classDiagram
    class Species {
        <<enumeration>>
        DOG
        CAT
        ANY
    }

    class Priority {
        <<enumeration, IntEnum>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
    }

    class Recurrence {
        <<enumeration>>
        NONE
        DAILY
        WEEKLY
        +interval() timedelta
    }

    class Owner {
        +str id
        +str name
        +int available_start
        +int available_end
        +List~Pet~ pets
        +add_pet(pet) void
        +get_all_tasks() List~Task~
        +is_available(task) bool
    }

    class Pet {
        +str id
        +str name
        +int age
        +str breed
        +Species species
        +Owner owner
        +List~Task~ tasks
        +add_task(task) void
        +list_tasks() List~Task~
    }

    class Task {
        +str id
        +str description
        +datetime start_time
        +int duration
        +Priority priority
        +Recurrence recurrence
        +bool completed
        +Pet pet
        +overlaps(other) bool
        +mark_complete(now) Task
    }

    class Scheduler {
        +Owner owner
        +sort_tasks(tasks) List~Task~
        +filter_tasks(tasks, pet, completed, min_priority) List~Task~
        +find_conflicts(tasks) List~Tuple~
        +check_conflict(task) str
        +build_schedule() List~Task~
    }

    class KnowledgeBase {
        <<data, knowledge folder>>
        +title
        +species
        +life_stage
        +tags
        +source_url
        +body text
        +Suggested tasks list
    }

    class Chunk {
        +str id
        +str title
        +str text
        +str species
        +str life_stage
        +List~str~ tags
        +List~str~ source_urls
        +source_url str
    }

    class Hit {
        +Chunk chunk
        +float score
    }

    class BM25 {
        +score(query_tokens, index) float
    }

    class Retriever {
        +List~Chunk~ chunks
        +retrieve(query, k, species, life_stage) List~Hit~
    }

    class RetrievalFunctions {
        <<module, rag.py>>
        +load_chunks(directory) List~Chunk~
        +life_stage_for(pet) str
        +retrieve_for_pet(pet, retriever, per_topic) List~Hit~
    }

    class Suggestion {
        +str description
        +int duration_minutes
        +Priority priority
        +Recurrence recurrence
        +str reason
        +str source_id
        +str source_title
        +str source_url
    }

    class SuggestionFunctions {
        <<module, suggestions.py>>
        +suggest_from_guides(pet, retriever) List~Suggestion~
        +suggestion_to_task(suggestion, start_time) Task
        +default_start_times(suggestions, day) List~datetime~
    }

    class StreamlitApp {
        <<module, app.py>>
        +choose(label, items, format_func) Any
        +safe_action(what) void
        +show_conflicts(tasks, message) void
    }

    class LoggingConfig {
        <<module, logging_config.py>>
        +setup_logging(level, log_dir) Logger
    }

    class RetrievalEvaluation {
        <<evaluator, eval_retrieval.py>>
        +run_profile_cases(retriever) List~ProfileResult~
        +run_query_cases(retriever) List~QueryResult~
        +summarize(profiles, queries) dict
    }

    class TestSuite {
        <<tester, pytest>>
        +test_pawpal()
        +test_rag()
        +test_suggestions()
        +test_retrieval_eval()
        +test_app_flow()
        +test_logging()
    }

    class PetOwner {
        <<human>>
        +enters pets and tasks
        +reviews each suggestion and source
        +edits the start time
        +clicks Add to schedule
        +resolves conflict warnings
    }

    class GuideReviewer {
        <<human>>
        +checks each guide against its source pages
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" o-- "*" Task : has
    Pet --> Species
    Task --> Priority
    Task --> Recurrence
    Scheduler --> Owner : schedules for
    Scheduler ..> Task : sorts, filters, detects conflicts

    RetrievalFunctions ..> KnowledgeBase : loads guides from
    RetrievalFunctions ..> Chunk : creates one per guide
    RetrievalFunctions ..> Pet : reads species and age
    RetrievalFunctions ..> Retriever : queries once per care topic
    Retriever "1" o-- "*" Chunk
    Retriever --> BM25 : ranks with
    Retriever ..> Hit : returns ranked guides
    Hit --> Chunk

    SuggestionFunctions ..> RetrievalFunctions : retrieve_for_pet picks guides
    SuggestionFunctions ..> Suggestion : reads each guide task list into
    SuggestionFunctions ..> Task : suggestion_to_task builds
    Suggestion --> Priority
    Suggestion --> Recurrence
    Suggestion ..> Chunk : cites guide by id

    StreamlitApp ..> Owner : holds
    StreamlitApp ..> SuggestionFunctions : shows suggestions with sources
    StreamlitApp ..> Scheduler : conflict check and schedule
    StreamlitApp ..> LoggingConfig : setup_logging

    PetOwner --> StreamlitApp : uses
    GuideReviewer ..> KnowledgeBase : verifies content
    TestSuite ..> RetrievalFunctions : tests
    TestSuite ..> SuggestionFunctions : tests
    TestSuite ..> Scheduler : tests
    TestSuite ..> StreamlitApp : drives every flow
    RetrievalEvaluation ..> Retriever : scores retrieval quality

    note for PetOwner "Nothing reaches the schedule until the owner clicks Add"
    note for SuggestionFunctions "No language model or agent: suggestions come straight from the guides, so results are the same every time"
    note for RetrievalEvaluation "Checks that each test pet gets the guides it needs and none that are wrong for it"
